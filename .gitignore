# ==========================================
# AI Surveillance Agent - .gitignore
# ==========================================

# ----- Secrets (حرج جداً) -----
.env
.env.*
.env.local
.env.*.local
*.env
!.env.example

# ----- Python -----
venv/
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# ----- ML Models (ملفات كبيرة) -----
*.pt
*.pth
*.onnx
*.h5
*.tflite
models/*.pt
models/*.pth
models/*.onnx

# ----- Data & Logs -----
alerts/
logs/
config.json
config.json.tmp
*.log
*.jsonl
chroma_data/
data/

# ----- Frontend (Next.js) -----
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env*.local
!frontend/.env.example
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ----- Root Node (إن وُجد) -----
node_modules/
.next/
.npm/
*.tsbuildinfo

# ----- Reports (تقارير داخلية) -----
reports/*.md
reports/*.txt
!reports/README.md

# ----- IDE & OS -----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ----- Backup files -----
*.bak
*.backup
*~
*.orig
