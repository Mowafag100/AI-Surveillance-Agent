# ============================================================
# AI Surveillance Agent — نموذج متغيّرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم الحقيقية.
# تحذير: ملف .env مُستثنى من Git ولا يجب رفعه أبداً.
# ============================================================

# ------------------- Docker Compose -------------------
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_USER=surveillance_user
POSTGRES_DB=surveillance_db

# ------------------- الكاميرا -------------------
CAMERA_URL=http://CAMERA_IP:PORT/video

# ------------------- Telegram -------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------- إعدادات الكشف -------------------
MIN_CONFIDENCE=0.3

# ------------------- المنطقة الحساسة -------------------
ZONE_TOP_LEFT_X=0
ZONE_TOP_LEFT_Y=0
ZONE_BOTTOM_RIGHT_X=1280
ZONE_BOTTOM_RIGHT_Y=720
ZONE_DWELL_TIME=2.0
ALERT_COOLDOWN=30
ALERT_START_HOUR=0
ALERT_END_HOUR=23

# ------------------- المصادقة (Admin UI) -------------------
# سر JWT — غيّره إلى قيمة قوية قبل الإنتاج (pattern من قالب full-stack-fastapi)
JWT_SECRET_KEY=change_me_strong_jwt_secret
# مدة صلاحية التوكن بالدقائق (7 أيام افتراضياً كالقالب)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# عنوان API من داخل الخادم (لبيئة Docker داخل نفس الشبكة: http://api:8090)
# API_URL=http://api:8090

# تحسينات الكشف
ENABLE_FALL_DETECTION=true
ENABLE_FIGHT_DETECTION=true
FALL_ASPECT_RATIO_THRESHOLD=1.2
FIGHT_SPEED_THRESHOLD=100
FIGHT_DISTANCE_THRESHOLD=50

# ------------------- التطبيق -------------------
PORT=8090
NEXT_PUBLIC_API_URL=http://localhost:8090

# عرض نافذة الفيديو — اتركه false في Docker/الخوادم، true للتطوير المحلي على جهاز به شاشة
SHOW_PREVIEW=false
