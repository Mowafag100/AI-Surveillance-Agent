# ============================================================
# AI Surveillance Agent — نموذج متغيّرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم الحقيقية.
# تحذير: ملف .env مُستثنى من Git ولا يجب رفعه أبداً.
# ============================================================

# ------------------- Docker Compose -------------------
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_USER=surveillance_user
POSTGRES_DB=surveillance_db

# ------------------- الكاميرا -------------------
CAMERA_URL=http://CAMERA_IP:PORT/video

# ------------------- Telegram -------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------- مراقبة صحة الكاميرات -------------------
# مهلة الثواني قبل اعتبار الكاميرا انقطعت (تنبيه تيليجرام واحد لكل انقطاع)
CAMERA_TIMEOUT_SEC=30

# ------------------- تنبيهات البريد الإلكتروني (SMTP) -------------------
# التفعيل: enable=true فقط؛ مع Gmail استخدم port=587 (+كلمة مرور التطبيقات) أو 465
ENABLE_EMAIL_ALERTS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ------------------- إعدادات الكشف -------------------
MIN_CONFIDENCE=0.3
# مهلة منع التكرار لكل شخص متتبَّع (track_id) بالثواني — بلا تنبيه مكرر لنفس الشخص
TRACK_COOLDOWN_SEC=60

# ------------------- التعرف على الوجوه (الموظفون) -------------------
# تشابه كوسين الأدنى لمطابقة موظف — رفع يلغي الإنذارات الكاذبة عبر أشخاص
# متشابهين، وخفضه (مثلاً 0.80) يقبل زوايا/إضاءات مختلفة
FACE_MATCH_THRESHOLD=0.85

# ------------------- المنطقة الحساسة -------------------
ZONE_TOP_LEFT_X=0
ZONE_TOP_LEFT_Y=0
ZONE_BOTTOM_RIGHT_X=1280
ZONE_BOTTOM_RIGHT_Y=720
ZONE_DWELL_TIME=2.0
ALERT_COOLDOWN=30
ALERT_START_HOUR=0
ALERT_END_HOUR=23

# ------------------- المصادقة (Admin UI) -------------------
# سر JWT — غيّره إلى قيمة قوية قبل الإنتاج (pattern من قالب full-stack-fastapi)
JWT_SECRET_KEY=change_me_strong_jwt_secret
# مدة صلاحية التوكن بالدقائق (7 أيام افتراضياً كالقالب)
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# جعل كل مستخدم جديد مشرفاً (Superuser) عند التسجيل — غيّرها إلى false لإلغاء ذلك
REGISTER_AS_ADMIN=true
# عنوان API من داخل الخادم (لبيئة Docker داخل نفس الشبكة: http://api:8090)
# API_URL=http://api:8090

# تحسينات الكشف
ENABLE_FALL_DETECTION=true
ENABLE_FIGHT_DETECTION=true
FALL_ASPECT_RATIO_THRESHOLD=1.2
FIGHT_SPEED_THRESHOLD=100
FIGHT_DISTANCE_THRESHOLD=50

# ------------------- AI Chat / المساعد الذكي للمحادثة (POST /api/chat) -------------------
# تُقرأ من بيئة العمل حصراً — لا تُكتب في config.json ولا تظهر في الواجهة
# 1) إن وُجد مفتاح OpenAI يُستخدم أولاً (احذف # وتعوض القيمة):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# 2) وإلا يُستخدم Ollama المحلي (يجب أن يكون مثبتاً وشغالاً):
# - التشغيل المباشر على جهاز المضيف:
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
# - داخل Docker (compose يضبطها تلقائياً في خدمة api عبر extra_hosts):
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:1.5b
# 3) ونقصهما معاً: إجابة قاعدية محسوبة مباشرة من بيانات سجل الأحداث

# ------------------- كشف السلوك الشاذ (معدلة عبر config.json كذلك) -------------------
ENABLE_ANOMALY_DETECTION=true
# سرعة الجري على إطار المعالجة 640×480 بكسل/ثانية (المشي ~20-60)
RUN_SPEED_THRESHOLD_PX=150
# مدة الثبات في مساحة صغيرة قرب المنطقة الحساسة قبل حدث «توقّف مشبوه»
LOITERING_SEC=60
LOITERING_RADIUS_PX=40
# مهلة منع تكرار الحدث الشاذ لكل (كاميرا، شخص، نوع)
ANOMALY_EVENT_COOLDOWN=20

# ------------------- التطبيق -------------------
PORT=8090
NEXT_PUBLIC_API_URL=http://localhost:8090

# عرض نافذة الفيديو — اتركه false في Docker/الخوادم، true للتطوير المحلي على جهاز به شاشة
SHOW_PREVIEW=false
