# ============================================================
# AI Surveillance Agent — نموذج متغيّرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم الحقيقية.
# تحذير: ملف .env مُستثنى من Git ولا يجب رفعه أبداً.
# ============================================================

# ------------------- Docker Compose -------------------
# كلمة مرور PostgreSQL — مطلوبة لتشغيل docker-compose
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_USER=surveillance_user
POSTGRES_DB=surveillance_db

# يُبنى تلقائياً من القيم أعلاه عند تشغيل docker-compose.
# عند التشغيل خارج Docker، عرّفه يدوياً:
# DATABASE_URL=postgresql+asyncpg://surveillance_user:CHANGE_ME_STRONG_PASSWORD@postgres:5432/surveillance_db

# REDIS_URL=redis://redis:6379

# ------------------- الكاميرا -------------------
# ضع رابط الكاميرا الحقيقي في .env وليس هنا
CAMERA_URL=http://CAMERA_IP:PORT/video

# كاميرات متعددة (JSON)
# CAMERAS=[{"id":1,"name":"Gate","url":"http://CAMERA_IP:PORT/video"}]

# ------------------- Telegram -------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------- إعدادات الكشف -------------------
MIN_CONFIDENCE=0.3

# ------------------- المنطقة الحساسة -------------------
ZONE_TOP_LEFT_X=0
ZONE_TOP_LEFT_Y=0
ZONE_BOTTOM_RIGHT_X=1280
ZONE_BOTTOM_RIGHT_Y=720

# مدة البقاء والمهلة
ZONE_DWELL_TIME=2.0
ALERT_COOLDOWN=30

# التوقيت
ALERT_START_HOUR=0
ALERT_END_HOUR=23

# تحسينات الكشف
ENABLE_FALL_DETECTION=true
ENABLE_FIGHT_DETECTION=true
FALL_ASPECT_RATIO_THRESHOLD=1.2
FIGHT_SPEED_THRESHOLD=100
FIGHT_DISTANCE_THRESHOLD=50

# ------------------- التطبيق -------------------
# منفذ خادم الـ API (main.py)
PORT=8091

# ------------------- Frontend (Next.js) -------------------
# يجب أن يطابق PORT أعلاه (منفذ الـ API)
NEXT_PUBLIC_API_URL=http://localhost:8091
