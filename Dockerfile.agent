FROM python:3.11-slim

WORKDIR /app

# تثبيت التبعيات النظامية (معدل)
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    wget \
    && rm -rf /var/lib/apt/lists/*

# نسخ ملف المتطلبات وتثبيت الحزم
COPY requirements.agent.txt .
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu -r requirements.agent.txt

# تحميل نموذج YOLO (يُحمّل عند التشغيل الأول)
RUN python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"

# نسخ الكود
COPY src/ ./src/
COPY main.py .
# لا نسخ ملف .env (يحتوي أسراراً) — نأخذ القالب فقط، والقيم الحقيقية تأتي
# من بيئة docker-compose وملف .env المُحمَّل وقت التشغيل.
COPY .env.example .env

CMD ["python", "main.py"]
